{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@tpl/*": ["./template/src/*"],
      "hy3d-spec": ["./scripts/hy3d-spec.d.ts"],
      "hymd-spec": ["./scripts/hymd-spec.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
